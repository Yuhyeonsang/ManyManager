# ==========================================
# 펀드매니저 환경변수 템플릿
# ==========================================
# 사용법:
#   1) 이 파일을 복사해서 이름을 ".env" 로 바꾸세요
#      (점으로 시작! Windows 탐색기에서 "보기 → 파일 확장명" 켜고 작업)
#   2) 아래 빈 칸들에 실제 키를 채워 넣으세요
#   3) .env 는 절대 GitHub 등에 올리지 마세요 (.gitignore 에 이미 등록됨)
# ==========================================

# ─── Google Gemini ─────────────────────────
# 발급: https://aistudio.google.com/apikey
# 무료 티어: Gemini 1.5 Flash 하루 1500회
GEMINI_API_KEY=여기에_Gemini_API_키_붙여넣기

# ─── 네이버 검색 API (뉴스 수집) ────────────
# 발급: https://developers.naver.com/apps/#/list
#       → 새 앱 등록 → "검색" API 사용 체크
NAVER_CLIENT_ID=여기에_네이버_Client_ID
NAVER_CLIENT_SECRET=여기에_네이버_Client_Secret

# ─── 금융감독원 DART (재무제표) ─────────────
# 발급: https://opendart.fss.or.kr/uss/umt/cnfirmKey.do
#       → 가입 후 인증키 발급 (즉시 발급, 무료)
DART_API_KEY=여기에_DART_인증키

# ─── 모니터링 루프 옵션 (monitor_loop.py) ──
FUND_DB=fund_manager.db
LOOP_INTERVAL_MIN=15
DAILY_BUDGET_USD=1.0
USD_KRW=1380
