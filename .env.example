# ==========================================
# 펀드매니저 환경변수 템플릿
# ==========================================

# ─── LLM provider 선택 (gemini | groq) ──────
LLM_PROVIDER=gemini

# ─── Google Gemini ──────────────────────────
# 발급: https://aistudio.google.com/apikey
# gemini-3-flash 무료: 분당10 / 일1500 요청. (gemini-2.5-flash는 일250으로 적음)
GEMINI_API_KEY=여기에_Gemini_API_키
GEMINI_MODEL=gemini-3-flash-preview

# ─── Groq (백업용) ──────────────────────────
GROQ_API_KEY=여기에_Groq_API_키
GROQ_MODEL=llama-3.1-8b-instant

# ─── 내부 호출 제한 (모델 무료 한도에 맞춤) ─
GEMINI_RPM=10
GEMINI_DAILY=1400

# ─── 네이버 검색 API ────────────────────────
NAVER_CLIENT_ID=여기에_네이버_Client_ID
NAVER_CLIENT_SECRET=여기에_네이버_Client_Secret

# ─── DART ───────────────────────────────────
DART_API_KEY=여기에_DART_인증키

# ─── Tiingo ─────────────────────────────────
TIINGO_API_KEY=여기에_Tiingo_토큰

# ─── 한국투자증권(KIS) REST API (자동매매) ───
# 발급: https://apiportal.koreainvestment.com (위탁계좌 + 앱키/시크릿)
# 국내+미국(TQQQ) 한 계좌로 가능. 실전=real / 모의=paper
KIS_APP_KEY=여기에_한투_앱키
KIS_APP_SECRET=여기에_한투_시크릿키
KIS_ACCOUNT_NO=계좌번호-01
KIS_TRADE_MODE=real
# 미국 종목(TQQQ 등) 거래소. 기본 NASD(나스닥). NYSE/AMEX면 변경
KIS_US_EXCHANGE=NASD

# ─── 모니터링 루프 ──────────────────────────
FUND_DB=fund_manager.db
LOOP_INTERVAL_MIN=15
DAILY_BUDGET_USD=1.0
USD_KRW=1380
