# ==========================================
# 펀드매니저 환경변수 템플릿
# ==========================================
# 사용법:
#   1) 이 파일을 복사해서 이름을 ".env" 로 바꾸세요
#      (점으로 시작! Windows 탐색기에서 "보기 → 파일 확장명" 켜고 작업)
#   2) 아래 빈 칸들에 실제 키를 채워 넣으세요
#   3) .env 는 절대 GitHub 등에 올리지 마세요 (.gitignore 에 이미 등록됨)
# ==========================================

# ─── Groq (Llama) — 우선 사용, 한도 넉넉 ────
# 발급: https://console.groq.com/keys
# GROQ_API_KEY 가 있으면 뉴스선별/감성/리포트 모두 Groq 사용 (없으면 Gemini 폴백)
GROQ_API_KEY=여기에_Groq_API_키_붙여넣기
# 내부 호출 제한 — Groq 기준으로 상향 (기본 10/250은 옛 Gemini 무료티어용)
GEMINI_RPM=30
GEMINI_DAILY=14000

# ─── Google Gemini (폴백) ───────────────────
# 발급: https://aistudio.google.com/apikey
# 무료 티어: Gemini 1.5 Flash 하루 1500회
GEMINI_API_KEY=여기에_Gemini_API_키_붙여넣기

# ─── 네이버 검색 API (뉴스 수집) ────────────
# 발급: https://developers.naver.com/apps/#/list
#       → 새 앱 등록 → "검색" API 사용 체크
NAVER_CLIENT_ID=여기에_네이버_Client_ID
NAVER_CLIENT_SECRET=여기에_네이버_Client_Secret

# ─── 금융감독원 DART (재무제표) ─────────────
# 발급: https://opendart.fss.or.kr/uss/umt/cnfirmKey.do
#       → 가입 후 인증키 발급 (즉시 발급, 무료)
DART_API_KEY=여기에_DART_인증키

# ─── 한국투자증권 KIS API (자동매매) ────────
# 발급: https://apiportal.koreainvestment.com
#       → 로그인 → API Key 신청 → 실전투자 앱 생성
# 주의: 실전 계좌로 실제 돈 거래됨. 신중히 사용하세요.
KIS_APP_KEY=여기에_KIS_앱키
KIS_APP_SECRET=여기에_KIS_앱시크릿
KIS_ACCOUNT_NO=계좌번호-상품코드  # 예) 50100000-01
KIS_TRADE_MODE=real               # real(실전) 또는 paper(모의)

# ─── 모니터링 루프 옵션 (monitor_loop.py) ──
FUND_DB=fund_manager.db
LOOP_INTERVAL_MIN=15
DAILY_BUDGET_USD=1.0
USD_KRW=1380
