[Unit]
Description=FundManager FastAPI Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/fund-manager
EnvironmentFile=/opt/fund-manager/.env
# 서버 시작
ExecStart=/opt/fund-manager/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
# 충돌 시 자동 재시작
Restart=always
RestartSec=5
# 로그
StandardOutput=append:/var/log/fund-manager.log
StandardError=append:/var/log/fund-manager.log
# 보안 (선택)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
